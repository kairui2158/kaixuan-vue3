{
  "name": "shenyi-assistant",
  "version": "3.130.0",
  "description": "神意助手 - AI驱动的桌面小说写作应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:vue": "vite",
    "dev:electron": "electron . --dev",
    "build:vue": "vite build && vite build --config vite.protocols.config.mts",
    "build:vue:test": "vite build --mode test && vite build --mode test --config vite.protocols.config.mts",
    "build": "npm run build:vue && electron-builder --win",
    "build:portable": "npm run build:vue && electron-builder --win portable",
    "type-check": "vue-tsc --noEmit",
    "test:services": "vitest run",
    "sync:phrase-corpus": "node scripts/sync-chain-intent-phrase-corpus.cjs",
    "verify:phrase-corpus-sync": "node scripts/verify-phrase-corpus-sync.cjs",
    "evaluate:chain-intent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/evaluate-chain-intent-router.mjs",
    "verify:intent-embedding-node": "node scripts/verify-intent-embedding-node.mjs",
    "verify:intent-embedding-electron": "node scripts/verify-intent-embedding-electron.mjs",
    "verify:provider-wire-electron": "node scripts/verify-api-direct-write-provider-wire-electron.mjs",
    "verify:provider-channel-electron": "node scripts/verify-pipeline-provider-channel-electron.mjs",
    "verify:provider-channel-live": "SHENYI_PROVIDER_CHANNEL_LIVE=1 node scripts/verify-pipeline-provider-channel-electron.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "verify:deai-stage-guidance-live": "node scripts/verify-deai-stage-guidance-live.mjs",
    "verify:chapter-batch-contract-electron": "npm run build:vue && node scripts/verify-chapter-batch-contract-electron.mjs",
    "verify:outline-legacy-restore-electron": "node scripts/verify-outline-legacy-restore-electron.mjs",
    "verify:production-wiring": "depcruise src --config .dependency-cruiser.cjs"
  },
  "author": "kaixuan",
  "license": "MIT",
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@huggingface/transformers": "^3.7.5",
    "@node-rs/jieba": "^2.0.3",
    "@node-rs/jieba-wasm32-wasi": "^2.0.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "hotkeys-js": "^4.0.4",
    "idb": "^8.0.3",
    "jschardet": "^3.1.4",
    "marked": "^18.0.5",
    "pinia": "^4.0.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@biomejs/cli-win32-x64": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "dependency-cruiser": "^18.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.61.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.kaixuan.shenyi-assistant",
    "productName": "神意助手",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources/models/bge-small-zh-v1.5",
        "to": "models/bge-small-zh-v1.5",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "src/services/skillPackageProtocol.json",
      "node_modules/**/*",
      "!node_modules/**/.bin/**",
      "!node_modules/**/.cache/**",
      "!node_modules/**/@biomejs/**",
      "!node_modules/**/@electron/asar/**",
      "!node_modules/**/@electron/rebuild/**",
      "!node_modules/**/@playwright/**",
      "!node_modules/**/@playwright-test/**",
      "!node_modules/**/@vitejs/**",
      "!node_modules/**/@vue/**",
      "!node_modules/**/electron-builder/**",
      "!node_modules/**/electron-download/**",
      "!node_modules/**/vue-tsc/**",
      "!node_modules/**/typescript/**",
      "!node_modules/**/vite/**",
      "!node_modules/**/playwright/**",
      "!node_modules/**/playwright-core/**",
      "!node_modules/**/7zip-bin*/**",
      "!node_modules/**/.app-builder-bin*/**",
      "!node_modules/**/app-builder-lib/**",
      "!node_modules/**/builder-util/**",
      "!node_modules/**/dmg-builder/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "package.json",
      "!electron/**/*.spec.js"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "神意助手-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "神意助手",
      "include": "build/installer.nsh"
    },
    "asarUnpack": []
  }
}
