{
  "name": "shenyi-assistant",
  "version": "3.13.1",
  "description": "神意助手 - AI驱动的桌面小说写作应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:vue": "vite",
    "dev:electron": "electron . --dev",
    "build:vue": "vite build",
    "build": "npm run build:vue && electron-builder --win",
    "build:portable": "npm run build:vue && electron-builder --win portable",
    "type-check": "vue-tsc --noEmit",
    "test:services": "vitest run src/services/aiService.spec.ts src/services/memoryIO.spec.ts src/services/volumeGeneration.spec.ts"
  },
  "author": "kaixuan",
  "license": "MIT",
  "dependencies": {
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "dompurify": "^3.4.14",
    "electron-log": "^5.4.4",
    "hotkeys-js": "^4.0.4",
    "idb": "^8.0.3",
    "jschardet": "^3.1.4",
    "marked": "^18.0.5",
    "notyf": "^3.10.0",
    "pinia": "^4.0.2",
    "shiki": "^4.4.3",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@biomejs/cli-win32-x64": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "playwright": "^1.61.1",
    "typescript": "5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.kaixuan.shenyi-assistant",
    "productName": "神意助手",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-renderer/**/*",
      "node_modules/**/*",
      "!node_modules/**/.bin/**",
      "!node_modules/**/.cache/**",
      "!node_modules/**/@biomejs/**",
      "!node_modules/**/@electron/asar/**",
      "!node_modules/**/@electron/rebuild/**",
      "!node_modules/**/@playwright/**",
      "!node_modules/**/@playwright-test/**",
      "!node_modules/**/@vitejs/**",
      "!node_modules/**/@vue/**",
      "!node_modules/**/electron-builder/**",
      "!node_modules/**/electron-download/**",
      "!node_modules/**/vue-tsc/**",
      "!node_modules/**/typescript/**",
      "!node_modules/**/vite/**",
      "!node_modules/**/playwright/**",
      "!node_modules/**/playwright-core/**",
      "!node_modules/**/7zip-bin*/**",
      "!node_modules/**/.app-builder-bin*/**",
      "!node_modules/**/app-builder-lib/**",
      "!node_modules/**/builder-util/**",
      "!node_modules/**/dmg-builder/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "神意助手-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "神意助手",
      "include": "build/installer.nsh"
    },
    "asarUnpack": []
  }
}
